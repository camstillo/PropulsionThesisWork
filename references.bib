@article{turnerDevelopmentNextGenerationLatticed2024,
  title = {The {{Development}} of a {{Next-Generation Latticed Resistojet Thruster}} for {{CubeSats}}},
  author = {Turner, Daniel and Howie, Robert and Bland, Phil},
  year = 2024,
