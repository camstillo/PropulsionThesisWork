@article{takatsyAttitudeDeterminationNanosatellites2022,
  title = {Attitude Determination for Nano-Satellites -- {{II}}. {{Dead}} Reckoning with a Multiplicative Extended {{Kalman}} Filter},
  author = {Tak{\'a}tsy, J{\'a}nos and Boz{\'o}ki, Tam{\'a}s and D{\'a}lya, Gergely and Kap{\'a}s, Korn{\'e}l and M{\'e}sz{\'a}ros, L{\'a}szl{\'o} and P{\'a}l, Andr{\'a}s},
